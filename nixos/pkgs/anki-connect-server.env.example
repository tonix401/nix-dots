# Template for ~/.config/anki-connect-server/env (the anki-connect-server user service won't start
# without it). Copy it there, fill in the AnkiWeb login and chmod 600. Never commit the real file.
ANKICONNECT_COLLECTION_PATH=/home/tom/.local/share/Anki2/User 1/collection.anki2
ANKICONNECT_PORT=8765
ANKICONNECT_BIND=127.0.0.1
ANKICONNECT_ANKIWEB_USER=
ANKICONNECT_ANKIWEB_PASS=
